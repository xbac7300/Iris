{
  "name": "@lms/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file=../../.env --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file=../../.env dist/db/migrate.js",
    "db:seed": "node --env-file=../../.env dist/db/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/jwt": "12.0.2",
    "class-validator": "0.15.1",
    "class-transformer": "0.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "pg": "8.23.0",
    "cookie": "2.0.1",
    "zod": "4.6.5",
    "dotenv": "18.0.2",
    "@lms/media-core": "workspace:*",
    "@lms/ai-core": "workspace:*",
    "@lms/contracts": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.4",
    "@types/express": "5.0.6",
    "supertest": "7.2.2",
    "@types/supertest": "7.2.1"
  }
}
