NODE_ENV=development
DATABASE_URL=postgresql://lms:REPLACE_DATABASE_PASSWORD@localhost:5432/lms
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
WEB_ORIGIN=http://localhost:3000
PORT=4000
API_PUBLIC_URL=http://localhost:4000
REDIS_URL=redis://localhost:6379
PYTHON_EXECUTABLE=services/asr/.venv/Scripts/python.exe
MEDIA_PROBE_SCRIPT=services/asr/probe.py
MEDIA_TEMP_DIR=.local/media-temp
MEDIA_QUEUE_NAME=media
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=lms-private
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_STORAGE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_STORAGE_SECRET_KEY
SEED_PASSWORD=REPLACE_DEMO_PASSWORD
# Model local miễn phí; bật sau khi tải model trong runbook.
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL_ID=qwen3-embedding:0.6b
GENERATION_MODEL_ID=qwen3:4b
EMBEDDING_DIMENSIONS=1024
AI_CHAT_DAILY_QUOTA=20
AI_BUDGET_USD=0
ASR_MODEL_PATH=REPLACE_LOCAL_MODEL_DIRECTORY
ASR_CONCURRENCY=1
UPLOAD_MAX_BYTES=524288000
UPLOAD_MAX_DURATION_SEC=3600
TELEMETRY_RETENTION_DAYS=14
